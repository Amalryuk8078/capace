# Copy to .env (repository root). Used by docker compose and by Django when run on the host.
# Never commit the real .env file.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=smart_task_board
POSTGRES_USER=smart_task_board
POSTGRES_PASSWORD=change-me
# Host-side connection details. The backend container overrides these in docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5440
REDIS_URL=redis://localhost:6390/0
# Host port for the RedisInsight web UI (redis-stack).
REDIS_EXPOSED_PORT=8001

# Hidden completion eligibility (rule 4). Keep the secret private.
TASK_ELIGIBILITY_SECRET=change-me-too
TASK_ELIGIBILITY_RATIO=0.8
